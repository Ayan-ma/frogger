	def determinegamestate(self,turncount):
		gamestate= turncount%2
		if gamestate==0:
			self.turn= "player"
			return self.turn
		elif gamestate==1:
			self.turn="ai"
			return self.turn
#/--------------------THIS SECTION IS FOR THE DECK ESSENTIAL FEATURE--------------------/	
	def deckempty(self):
		self.empty=False
		if len(self.deck)==0:
			self.empty=True
			return self.empty
		else:
			self.empty=False
			return self.empty
	def drawcard(self):
		limit=len(self.deck)-1
		if self.deckempty():
			self.reshuffle()
		else:
			if self.turn=="player":
				card=randint(0,limit)
				temp=self.deck[card]
				self.deck.pop(card)
				self.player_hand.append(temp)
			elif self.turn=="ai":
				card=randint(0,limit)
				temp=self.deck[card]
				self.deck.pop(card)
				self.ai_hand.append(temp)
	def reshuffle(self):
		if self.deckempty():
			lastcard=self.pile[len(self.pile)-1]
			while self.pile[0]!=lastcard:
				temp=self.pile[0]
				self.pile.pop(0)
				self.deck.append(temp)
	def setupcards(self):
		#set pile
		limit=len(self.deck)-1
		randomcard=randint(0,limit)
		temp=self.deck[randomcard]
		self.deck.pop(randomcard)
		self.pile.append(temp)
		#set playerhand
		count=0
		while count !=7:
			limit=len(self.deck)-1
			randomcard=randint(0,limit)
			temp=self.deck[randomcard]
			self.deck.pop(randomcard)
			self.player_hand.append(temp)
			count+=1
			
		#set ai hand
		count=0
		while count !=7:
			limit=len(self.deck)-1
			randomcard=randint(0,limit)
			temp=self.deck[randomcard]
			self.deck.pop(randomcard)
			self.ai_hand.append(temp)
			count+=1
		
		
				
